<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Sistema visual de RH Manager.

    Azul institucional sobre gris claro, tarjetas de esquinas redondeadas y aire
    entre elementos. Se conserva la monoespaciada para los datos tabulares
    (identidades, fechas, montos) porque ahi la alineacion en columna es
    funcional, no decorativa.

    Las claves conservan los nombres para no tocar las vistas: lo que cambia
    son los valores.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══ PALETA ═══ -->
    <Color x:Key="Tinta">#0F3D6E</Color>
    <Color x:Key="Tinta2">#0B3159</Color>
    <Color x:Key="Tinta3">#1B5E9C</Color>
    <Color x:Key="Papel">#F4F6F9</Color>
    <Color x:Key="Superficie">#FFFFFF</Color>
    <Color x:Key="Texto">#1C2530</Color>
    <Color x:Key="Acero">#5A6673</Color>
    <Color x:Key="Linea">#E2E7ED</Color>
    <Color x:Key="LineaFuerte">#C9D2DC</Color>
    <Color x:Key="AzulClaro">#E8F0F8</Color>

    <Color x:Key="Sello">#B4232A</Color>
    <Color x:Key="Ambar">#B7791F</Color>
    <Color x:Key="Verde">#1E7A4B</Color>

    <Color x:Key="SelloTenue">#FCEDED</Color>
    <Color x:Key="AmbarTenue">#FDF6E7</Color>
    <Color x:Key="VerdeTenue">#E8F3ED</Color>
    <Color x:Key="AceroTenue">#EDF1F5</Color>

    <!-- ═══ TIPOGRAFIA ═══ -->
    <x:String x:Key="FuenteTitular">Segoe UI</x:String>
    <x:String x:Key="FuenteTexto">Segoe UI</x:String>
    <x:String x:Key="FuenteDatos">Consolas</x:String>

    <Style x:Key="TituloPantalla" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTitular}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Texto}" />
    </Style>

    <Style x:Key="TituloSeccion" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTitular}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Texto}" />
    </Style>

    <Style x:Key="EtiquetaCampo" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource Acero}" />
    </Style>

    <Style x:Key="Cuerpo" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="TextColor" Value="{StaticResource Texto}" />
    </Style>

    <Style x:Key="CuerpoSuave" TargetType="Label" BasedOn="{StaticResource Cuerpo}">
        <Setter Property="TextColor" Value="{StaticResource Acero}" />
    </Style>

    <Style x:Key="Dato" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FuenteDatos}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Texto}" />
    </Style>

    <Style x:Key="DatoSuave" TargetType="Label" BasedOn="{StaticResource Dato}">
        <Setter Property="TextColor" Value="{StaticResource Acero}" />
    </Style>

    <Style x:Key="NumeroMetrica" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTitular}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Tinta}" />
    </Style>

    <!-- ═══ BOTONES ═══ -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Tinta}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20,11" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="TextColor" Value="{StaticResource Tinta}" />
        <Setter Property="BorderColor" Value="{StaticResource LineaFuerte}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinimumHeightRequest" Value="38" />
    </Style>

    <Style x:Key="BotonMenu" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="#CBDAE8" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="Campo" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Texto}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Acero}" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

</ResourceDictionary>
