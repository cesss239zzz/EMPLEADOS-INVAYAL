<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:empleados.VistaModelos"
             x:Class="empleados.Vistas.PaginaArranque"
             x:DataType="vm:VistaModeloArranque"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Tinta}"
             Title="RH Manager">

    <Grid RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1" Spacing="14" HorizontalOptions="Center" VerticalOptions="Center">

            <Image Source="logo.png" WidthRequest="72" HeightRequest="72"
                   Aspect="AspectFit" HorizontalOptions="Center" />

            <Label Text="RH Manager"
                   FontFamily="{StaticResource FuenteTitular}"
                   FontSize="46"
                   FontAttributes="Bold"                   TextColor="#FFFFFF"
                   HorizontalOptions="Center" />

            <Label Text="Expediente Digital del Personal"
                   FontFamily="{StaticResource FuenteTitular}"
                   FontSize="12"
                   CharacterSpacing="2.4"                   TextColor="#7C8F9C"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" WidthRequest="300" Color="{StaticResource Tinta3}" Margin="0,12" />

            <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                               IsVisible="{Binding EstaOcupado}"
                               Color="#FFFFFF" HeightRequest="22" HorizontalOptions="Center" />

            <Label Text="{Binding Mensaje}"
                   FontFamily="{StaticResource FuenteTexto}"
                   FontSize="13"
                   TextColor="#B7C4CE"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <Label Grid.Row="2"
               Text="Inversiones Ayala Alvarenga S. de R.L."
               FontFamily="{StaticResource FuenteTitular}"
               FontSize="10"
               CharacterSpacing="2"               TextColor="#4E6272"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,26" />
    </Grid>

</ContentPage>
