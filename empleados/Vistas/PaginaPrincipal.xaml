<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Contenedor de RH Manager: menu lateral fijo a la izquierda, barra superior con el
    buscador y area de contenido. Sigue la maqueta "Dashboard Administrativo":
    menu de 248px sobre azul casi negro, cabecera blanca de 64px y lienzo gris.

    Aca no vive ninguna pantalla. Cada una es un panel aparte, en Vistas/Paneles,
    y hereda el BindingContext de esta pagina.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:empleados.VistaModelos"
             xmlns:p="clr-namespace:empleados.Vistas.Paneles"
             x:Class="empleados.Vistas.PaginaPrincipal"
             x:DataType="vm:VistaModeloPrincipal"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Papel}"
             Title="RH Manager">

    <Grid ColumnDefinitions="248,*">

        <!-- ═══════════════════════ MENU LATERAL ═══════════════════════ -->
        <Grid Grid.Column="0"
              BackgroundColor="{StaticResource Tinta2}"
              RowDefinitions="Auto,*,Auto">

            <!-- Identidad del usuario -->
            <Grid Grid.Row="0" Padding="18,20,18,18" ColumnDefinitions="44,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource Tinta}"
                        Stroke="{StaticResource Tinta3}"
                        StrokeThickness="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label Text="{Binding InicialesUsuario}"
                           FontFamily="{StaticResource FuenteTitular}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding Usuario}"
                           FontFamily="{StaticResource FuenteTitular}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding PerfilTexto}"
                           FontFamily="{StaticResource FuenteTexto}"
                           FontSize="11"
                           TextColor="{StaticResource TextoMenu}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>

            <!-- Navegacion -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="10,4" Spacing="2">

                    <!-- Dashboard -->
                    <Grid HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Resumen" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{StaticResource Accion}"
                                StrokeThickness="0"
                                IsVisible="{Binding EsResumen}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                            <Path Grid.Column="0"
                                  Data="M1,1 H8 V8 H1 Z M12,1 H19 V6 H12 Z M12,10 H19 V19 H12 Z M1,12 H8 V19 H1 Z"
                                  Stroke="{Binding EsResumen, Converter={StaticResource PincelMenu}}"
                                  StrokeThickness="1.6"
                                  WidthRequest="20" HeightRequest="20"
                                  VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Dashboard"
                                   FontFamily="{StaticResource FuenteTexto}"
                                   FontSize="14"
                                   TextColor="{Binding EsResumen, Converter={StaticResource TextoMenu}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <!-- Colaboradores -->
                    <Grid HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Colaboradores" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{StaticResource Accion}"
                                StrokeThickness="0"
                                IsVisible="{Binding EsColaboradores}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                            <Path Grid.Column="0"
                                  Data="M7,3.2 A3,3 0 1,0 7,9.2 A3,3 0 1,0 7,3.2 Z M1.5,18 C1.5,14.6 3.9,11.8 7,11.8 C10.1,11.8 12.5,14.6 12.5,18 M14.6,4.4 A2.4,2.4 0 1,0 14.6,9.2 A2.4,2.4 0 1,0 14.6,4.4 Z M15,12 C17.1,12.5 18.5,14.5 18.5,17"
                                  Stroke="{Binding EsColaboradores, Converter={StaticResource PincelMenu}}"
                                  StrokeThickness="1.6"
                                  WidthRequest="20" HeightRequest="20"
                                  VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Colaboradores"
                                   FontFamily="{StaticResource FuenteTexto}"
                                   FontSize="14"
                                   TextColor="{Binding EsColaboradores, Converter={StaticResource TextoMenu}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <!-- Documentos -->
                    <Grid HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Documentos" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{StaticResource Accion}"
                                StrokeThickness="0"
                                IsVisible="{Binding EsDocumentos}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                            <Path Grid.Column="0"
                                  Data="M4,1.5 H12 L16,5.5 V18.5 H4 Z M12,1.5 V5.5 H16 M6.5,10 H13.5 M6.5,13.5 H13.5"
                                  Stroke="{Binding EsDocumentos, Converter={StaticResource PincelMenu}}"
                                  StrokeThickness="1.6"
                                  WidthRequest="20" HeightRequest="20"
                                  VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Documentos"
                                   FontFamily="{StaticResource FuenteTexto}"
                                   FontSize="14"
                                   TextColor="{Binding EsDocumentos, Converter={StaticResource TextoMenu}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <!-- Historial -->
                    <Grid HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Historial" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{StaticResource Accion}"
                                StrokeThickness="0"
                                IsVisible="{Binding EsHistorial}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                            <Path Grid.Column="0"
                                  Data="M10,2.5 A7.5,7.5 0 1,0 10,17.5 A7.5,7.5 0 1,0 10,2.5 Z M10,6 V10.4 L13.2,12.2"
                                  Stroke="{Binding EsHistorial, Converter={StaticResource PincelMenu}}"
                                  StrokeThickness="1.6"
                                  WidthRequest="20" HeightRequest="20"
                                  VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Historial"
                                   FontFamily="{StaticResource FuenteTexto}"
                                   FontSize="14"
                                   TextColor="{Binding EsHistorial, Converter={StaticResource TextoMenu}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <!-- Alertas -->
                    <Grid HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Alertas" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{StaticResource Accion}"
                                StrokeThickness="0"
                                IsVisible="{Binding EsAlertas}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                            <Path Grid.Column="0"
                                  Data="M10,2.2 C7.1,2.2 5.4,4.2 5.4,7.1 V11.6 L3.8,14.4 H16.2 L14.6,11.6 V7.1 C14.6,4.2 12.9,2.2 10,2.2 Z M8,16.4 C8.3,17.4 9.1,18 10,18 C10.9,18 11.7,17.4 12,16.4"
                                  Stroke="{Binding EsAlertas, Converter={StaticResource PincelMenu}}"
                                  StrokeThickness="1.6"
                                  WidthRequest="20" HeightRequest="20"
                                  VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Alertas"
                                   FontFamily="{StaticResource FuenteTexto}"
                                   FontSize="14"
                                   TextColor="{Binding EsAlertas, Converter={StaticResource TextoMenu}}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="2"
                                    BackgroundColor="{StaticResource Sello}"
                                    StrokeThickness="0"
                                    Padding="7,2"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HayAvisosPendientes}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Label Text="{Binding AvisosPendientes}"
                                       FontFamily="{StaticResource FuenteTitular}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Reportes -->
                    <Grid HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Reportes" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{StaticResource Accion}"
                                StrokeThickness="0"
                                IsVisible="{Binding EsReportes}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                            <Path Grid.Column="0"
                                  Data="M2.5,17.5 H17.5 M5.5,17.5 V11 M10,17.5 V5.5 M14.5,17.5 V8.5"
                                  Stroke="{Binding EsReportes, Converter={StaticResource PincelMenu}}"
                                  StrokeThickness="1.6"
                                  WidthRequest="20" HeightRequest="20"
                                  VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Reportes"
                                   FontFamily="{StaticResource FuenteTexto}"
                                   FontSize="14"
                                   TextColor="{Binding EsReportes, Converter={StaticResource TextoMenu}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Pie del menu -->
            <VerticalStackLayout Grid.Row="2" Padding="10,10,10,16" Spacing="2">
                <BoxView Color="{StaticResource Tinta3}" HeightRequest="1" Margin="4,0,4,10" />

                <!-- Configuracion -->
                <Grid HeightRequest="44">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Configuracion" />
                    </Grid.GestureRecognizers>
                    <Border BackgroundColor="{StaticResource Accion}"
                            StrokeThickness="0"
                            IsVisible="{Binding EsConfiguracion}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                    </Border>
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                        <Path Grid.Column="0"
                              Data="M2.5,6 H17.5 M2.5,14 H17.5 M7,3.8 A2.2,2.2 0 1,0 7,8.2 A2.2,2.2 0 1,0 7,3.8 Z M13,11.8 A2.2,2.2 0 1,0 13,16.2 A2.2,2.2 0 1,0 13,11.8 Z"
                              Stroke="{Binding EsConfiguracion, Converter={StaticResource PincelMenu}}"
                              StrokeThickness="1.6"
                              WidthRequest="20" HeightRequest="20"
                              VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Configuración"
                               FontFamily="{StaticResource FuenteTexto}"
                               FontSize="14"
                               TextColor="{Binding EsConfiguracion, Converter={StaticResource TextoMenu}}"
                               VerticalOptions="Center" />
                    </Grid>
                </Grid>

                <!-- Cambiar de empresa -->
                <Grid HeightRequest="44">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CambiarEmpresaCommand}" />
                    </Grid.GestureRecognizers>
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                        <Path Grid.Column="0"
                              Data="M2,17.5 H18 M4,17.5 V5 L10,2.5 V17.5 M10,7 H16 V17.5 M6.4,8.5 V9.5 M6.4,12 V13"
                              Stroke="{StaticResource PincelMenu}"
                              StrokeThickness="1.6"
                              WidthRequest="20" HeightRequest="20"
                              VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Cambiar de empresa"
                               FontFamily="{StaticResource FuenteTexto}"
                               FontSize="14"
                               TextColor="{StaticResource TextoMenu}"
                               VerticalOptions="Center" />
                    </Grid>
                </Grid>

                <!-- Cerrar sesion -->
                <Grid HeightRequest="44">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CerrarSesionCommand}" />
                    </Grid.GestureRecognizers>
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Padding="14,0" InputTransparent="True">
                        <Path Grid.Column="0"
                              Data="M11.5,3 H4 V17 H11.5 M8.5,10 H17.5 M14.5,7 L17.5,10 L14.5,13"
                              Stroke="{StaticResource PincelSello}"
                              StrokeThickness="1.6"
                              WidthRequest="20" HeightRequest="20"
                              VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Cerrar sesión"
                               FontFamily="{StaticResource FuenteTexto}"
                               FontSize="14"
                               TextColor="#E88B86"
                               VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- ═══════════════════════ AREA DE TRABAJO ═══════════════════════ -->
        <Grid Grid.Column="1" RowDefinitions="64,1,*" BackgroundColor="{StaticResource Papel}">

            <!-- Barra superior -->
            <Grid Grid.Row="0"
                  BackgroundColor="{StaticResource Superficie}"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="16"
                  Padding="24,0">

                <!-- Marca y empresa activa -->
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Label Text="RH Manager"
                           FontFamily="{StaticResource FuenteTitular}"
                           FontSize="20"
                           FontAttributes="Bold"
                           CharacterSpacing="-0.3"
                           TextColor="{StaticResource Texto}"
                           VerticalOptions="Center" />
                    <Label Text="|"
                           FontSize="18"
                           TextColor="{StaticResource LineaFuerte}"
                           VerticalOptions="Center" />
                    <Ellipse Fill="{Binding ColorEmpresa}"
                             WidthRequest="9" HeightRequest="9"
                             VerticalOptions="Center" />
                    <Label Text="{Binding EmpresaActiva}"
                           FontFamily="{StaticResource FuenteTitular}"
                           FontSize="18"
                           FontAttributes="Bold"
                           CharacterSpacing="-0.3"
                           TextColor="{StaticResource Texto}"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                </HorizontalStackLayout>

                <!-- Buscador -->
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource SuperficieSuave}"
                        Stroke="{StaticResource Linea}"
                        StrokeThickness="1"
                        Padding="12,0"
                        MaximumWidthRequest="420"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HeightRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                        <Path Grid.Column="0"
                              Data="M9,2.5 A6.5,6.5 0 1,0 9,15.5 A6.5,6.5 0 1,0 9,2.5 Z M13.7,13.7 L18,18"
                              Stroke="{StaticResource PincelAceroSuave}"
                              StrokeThickness="1.6"
                              WidthRequest="18" HeightRequest="18"
                              VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding Busqueda}"
                               Placeholder="Buscar colaboradores, documentos..."
                               PlaceholderColor="{StaticResource AceroSuave}"
                               TextColor="{StaticResource Texto}"
                               BackgroundColor="Transparent"
                               FontSize="13"
                               VerticalOptions="Center" />
                        <Border Grid.Column="2"
                                BackgroundColor="{StaticResource Superficie}"
                                Stroke="{StaticResource Linea}"
                                StrokeThickness="1"
                                Padding="6,2"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3" />
                            </Border.StrokeShape>
                            <Label Text="Ctrl+K"
                                   Style="{StaticResource DatoSuave}"
                                   FontSize="10" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Campana con globo -->
                <Grid Grid.Column="2" WidthRequest="34" VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Alertas" />
                    </Grid.GestureRecognizers>
                    <Path Data="M10,2.2 C7.1,2.2 5.4,4.2 5.4,7.1 V11.6 L3.8,14.4 H16.2 L14.6,11.6 V7.1 C14.6,4.2 12.9,2.2 10,2.2 Z M8,16.4 C8.3,17.4 9.1,18 10,18 C10.9,18 11.7,17.4 12,16.4"
                          Stroke="{StaticResource PincelAcero}"
                          StrokeThickness="1.6"
                          WidthRequest="20" HeightRequest="20"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                    <Ellipse Fill="{StaticResource PincelSello}"
                             WidthRequest="8" HeightRequest="8"
                             HorizontalOptions="End"
                             VerticalOptions="Start"
                             Margin="0,12,4,0"
                             IsVisible="{Binding HayAvisosPendientes}" />
                </Grid>

                <!-- Configuracion -->
                <Grid Grid.Column="3" WidthRequest="28" VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Configuracion" />
                    </Grid.GestureRecognizers>
                    <Path Data="M2.5,6 H17.5 M2.5,14 H17.5 M7,3.8 A2.2,2.2 0 1,0 7,8.2 A2.2,2.2 0 1,0 7,3.8 Z M13,11.8 A2.2,2.2 0 1,0 13,16.2 A2.2,2.2 0 1,0 13,11.8 Z"
                          Stroke="{StaticResource PincelAcero}"
                          StrokeThickness="1.6"
                          WidthRequest="20" HeightRequest="20"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Grid>

                <!-- Pastilla del usuario -->
                <Border Grid.Column="4"
                        BackgroundColor="{StaticResource AzulClaro}"
                        Stroke="{StaticResource Linea}"
                        StrokeThickness="1"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Label Text="{Binding InicialesUsuario}"
                           FontFamily="{StaticResource FuenteTitular}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Accion}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <BoxView Grid.Row="1" Color="{StaticResource Linea}" />

            <!-- Contenido: un panel a la vez -->
            <Grid Grid.Row="2">
                <p:PanelResumen IsVisible="{Binding PanelResumen}" />
                <p:PanelColaboradores IsVisible="{Binding PanelColaboradores}" />
                <p:PanelAlertas IsVisible="{Binding PanelAlertas}" />
                <p:PanelFicha IsVisible="{Binding PanelFicha}" />
                <p:PanelCatalogos IsVisible="{Binding PanelCatalogos}" />
                <p:PanelRespaldos IsVisible="{Binding PanelRespaldos}" />
                <p:PanelPendiente IsVisible="{Binding PanelPendiente}" />
                <p:PanelEdicion IsVisible="{Binding PanelEdicion}" />
                <p:PanelNovedad IsVisible="{Binding PanelNovedad}" />
                <p:PanelDocumento IsVisible="{Binding PanelDocumento}" />
                <p:PanelVistaPrevia IsVisible="{Binding PanelVistaPrevia}" />

                <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                                   IsVisible="{Binding EstaOcupado}"
                                   Color="{StaticResource Accion}"
                                   HeightRequest="26"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Start"
                                   Margin="0,12,0,0" />
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
