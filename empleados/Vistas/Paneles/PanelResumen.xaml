<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Pantalla de resumen, segun la maqueta "Dashboard Administrativo SIGEM":
    cuatro tarjetas de metricas, directorio rapido a la izquierda y alertas
    recientes a la derecha.

    Hereda el BindingContext de PaginaPrincipal. No tiene codigo detras mas alla
    del constructor (CLAUDE.md, regla 11).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:empleados.VistaModelos"
             xmlns:srv="clr-namespace:empleados.Servicios"
             x:Class="empleados.Vistas.Paneles.PanelResumen"
             x:DataType="vm:VistaModeloPrincipal">

    <ScrollView>
        <VerticalStackLayout Padding="32,26,32,32" Spacing="24">

            <!-- ═══ CABECERA ═══ -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <Label Text="{Binding TituloSeccion}" Style="{StaticResource TituloPantalla}" />
                    <Label Text="{Binding SubtituloSeccion}" Style="{StaticResource CuerpoSuave}" />
                </VerticalStackLayout>

                <!-- Exportar reporte -->
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource SuperficieSuave}"
                        Stroke="{StaticResource LineaFuerte}"
                        StrokeThickness="1"
                        Padding="16,0"
                        HeightRequest="42"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PendienteCommand}" CommandParameter="Exportar reporte" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="9" VerticalOptions="Center" InputTransparent="True">
                        <Path Data="M10,3 V12.5 M6.4,9 L10,12.6 L13.6,9 M3.5,17 H16.5"
                              Stroke="{StaticResource PincelTexto}"
                              StrokeThickness="1.6"
                              WidthRequest="18" HeightRequest="18"
                              VerticalOptions="Center" />
                        <Label Text="Exportar reporte"
                               Style="{StaticResource Cuerpo}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Nuevo registro -->
                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource Accion}"
                        StrokeThickness="0"
                        Padding="16,0"
                        HeightRequest="42"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PendienteCommand}" CommandParameter="Nuevo registro" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="9" VerticalOptions="Center" InputTransparent="True">
                        <Path Data="M10,4 V16 M4,10 H16"
                              Stroke="{StaticResource PincelBlanco}"
                              StrokeThickness="1.8"
                              WidthRequest="18" HeightRequest="18"
                              VerticalOptions="Center" />
                        <Label Text="Nuevo registro"
                               FontFamily="{StaticResource FuenteTexto}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- ═══ METRICAS ═══ -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="20">

                <!-- Total de colaboradores -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" StrokeShape="RoundRectangle 6,6,6,6" Padding="20,18">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,32">
                            <Label Grid.Column="0" Text="Total colaboradores"
                                   Style="{StaticResource TituloTarjeta}" VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource AzulClaro}"
                                    StrokeThickness="0"
                                    WidthRequest="32" HeightRequest="32" Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Path Data="M7,3.2 A3,3 0 1,0 7,9.2 A3,3 0 1,0 7,3.2 Z M1.5,18 C1.5,14.6 3.9,11.8 7,11.8 C10.1,11.8 12.5,14.6 12.5,18 M14.6,4.4 A2.4,2.4 0 1,0 14.6,9.2 A2.4,2.4 0 1,0 14.6,4.4 Z M15,12 C17.1,12.5 18.5,14.5 18.5,17"
                                      Stroke="{StaticResource PincelAccion}"
                                      StrokeThickness="1.5"
                                      WidthRequest="20" HeightRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Resumen.ColaboradoresActivos}" Style="{StaticResource NumeroMetrica}" />
                        <Label Text="{Binding Resumen.DetalleColaboradores}"
                               Style="{StaticResource CuerpoMenor}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Cumpleanos del mes -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" StrokeShape="RoundRectangle 6,6,6,6" Padding="20,18">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,32">
                            <Label Grid.Column="0" Text="Cumpleanos del mes"
                                   Style="{StaticResource TituloTarjeta}" VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource AzulClaro}"
                                    StrokeThickness="0"
                                    WidthRequest="32" HeightRequest="32" Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Path Data="M3,17.5 H17 V10.5 H3 Z M3,10.5 C3,9 4,8.5 5.4,8.5 H14.6 C16,8.5 17,9 17,10.5 M10,8.5 V4.6 M10,4.6 C8.6,4.6 8.2,3.6 8.6,2.9 C9,2.2 10,2.4 10,3.6 C10,2.4 11,2.2 11.4,2.9 C11.8,3.6 11.4,4.6 10,4.6 Z"
                                      Stroke="{StaticResource PincelAccion}"
                                      StrokeThickness="1.5"
                                      WidthRequest="20" HeightRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Resumen.CumpleanosDelMes}" Style="{StaticResource NumeroMetrica}" />
                        <Label Text="{Binding Resumen.DetalleCumpleanos}"
                               Style="{StaticResource CuerpoMenor}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Documentos por vencer -->
                <Border Grid.Column="2"
                        BackgroundColor="#FFFBF3"
                        Stroke="#F0D5A8"
                        StrokeThickness="1"
                        Padding="20,18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,32">
                            <Label Grid.Column="0" Text="Documentos por vencer"
                                   Style="{StaticResource TituloTarjeta}"
                                   TextColor="{StaticResource Ambar}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource AmbarTenue}"
                                    StrokeThickness="0"
                                    WidthRequest="32" HeightRequest="32" Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Path Data="M4,1.5 H12 L16,5.5 V18.5 H4 Z M12,1.5 V5.5 H16 M10,8.5 V12.5 M10,15 V15.4"
                                      Stroke="{StaticResource PincelAmbar}"
                                      StrokeThickness="1.5"
                                      WidthRequest="20" HeightRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Resumen.DocumentosPorVencer}"
                               Style="{StaticResource NumeroMetrica}"
                               TextColor="{StaticResource Ambar}" />
                        <Label Text="{Binding Resumen.DetalleDocumentos}"
                               Style="{StaticResource CuerpoMenor}"
                               TextColor="{StaticResource Ambar}" />
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding Resumen.HayDocumentosPorVencer}">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Alertas" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="Ver detalles"
                                   FontFamily="{StaticResource FuenteTexto}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Ambar}"
                                   VerticalOptions="Center" />
                            <Path Data="M7.5,4 L13.5,10 L7.5,16"
                                  Stroke="{StaticResource PincelAmbar}"
                                  StrokeThickness="1.8"
                                  WidthRequest="14" HeightRequest="20"
                                  VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Contratos por vencer -->
                <Border Grid.Column="3"
                        BackgroundColor="#FFF7F6"
                        Stroke="#F2C7C1"
                        StrokeThickness="1"
                        Padding="20,18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,32">
                            <Label Grid.Column="0" Text="Contratos por vencer"
                                   Style="{StaticResource TituloTarjeta}"
                                   TextColor="{StaticResource Sello}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource SelloTenue}"
                                    StrokeThickness="0"
                                    WidthRequest="32" HeightRequest="32" Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Path Data="M10,2.6 L18.6,17.4 H1.4 Z M10,8 V12 M10,14.4 V14.8"
                                      Stroke="{StaticResource PincelSello}"
                                      StrokeThickness="1.5"
                                      WidthRequest="20" HeightRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Resumen.ContratosPorVencer}"
                               Style="{StaticResource NumeroMetrica}"
                               TextColor="{StaticResource Sello}" />
                        <Label Text="{Binding Resumen.DetalleContratos}"
                               Style="{StaticResource CuerpoMenor}"
                               TextColor="{StaticResource Sello}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ═══ DIRECTORIO Y ALERTAS ═══ -->
            <Grid ColumnDefinitions="*,376" ColumnSpacing="20">

                <!-- Directorio rapido -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" StrokeShape="RoundRectangle 6,6,6,6" VerticalOptions="Start">
                    <VerticalStackLayout>

                        <Grid Padding="22,18" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Directorio rapido"
                                   Style="{StaticResource TituloSeccion}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IrASeccionCommand}" CommandParameter="Colaboradores" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="Ver todos"
                                       FontFamily="{StaticResource FuenteTexto}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Accion}"
                                       VerticalOptions="Center" />
                                <Path Data="M7.5,4 L13.5,10 L7.5,16"
                                      Stroke="{StaticResource PincelAccion}"
                                      StrokeThickness="1.8"
                                      WidthRequest="14" HeightRequest="20"
                                      VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Cabecera de columnas -->
                        <Grid Padding="22,10" ColumnDefinitions="2.2*,1.6*,1.4*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Colaborador" Style="{StaticResource EtiquetaCampo}" />
                            <Label Grid.Column="1" Text="Cargo" Style="{StaticResource EtiquetaCampo}" />
                            <Label Grid.Column="2" Text="Departamento" Style="{StaticResource EtiquetaCampo}" />
                            <Label Grid.Column="3" Text="Estado" Style="{StaticResource EtiquetaCampo}"
                                   WidthRequest="86" />
                        </Grid>
                        <BoxView Color="{StaticResource Linea}" HeightRequest="1" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Directorio}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="srv:FilaColaborador">
                                    <Grid>
                                        <Grid Padding="22,12" ColumnDefinitions="2.2*,1.6*,1.4*,Auto" ColumnSpacing="12">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VistaModeloPrincipal}}, Path=AbrirFichaCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <Grid Grid.Column="0" ColumnDefinitions="38,*" ColumnSpacing="12">
                                                <Border Grid.Column="0"
                                                        BackgroundColor="{StaticResource AzulClaro}"
                                                        StrokeThickness="0"
                                                        WidthRequest="38" HeightRequest="38" Padding="0"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="19" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Iniciales}"
                                                           FontFamily="{StaticResource FuenteTitular}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Accion}"
                                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding NombreCompleto}"
                                                           Style="{StaticResource Cuerpo}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Codigo, StringFormat='ID: {0}'}"
                                                           Style="{StaticResource DatoSuave}" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <Label Grid.Column="1" Text="{Binding Puesto}"
                                                   Style="{StaticResource CuerpoMenor}"
                                                   TextColor="{StaticResource Texto}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding Departamento}"
                                                   Style="{StaticResource CuerpoMenor}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation" />

                                            <Border Grid.Column="3"
                                                    BackgroundColor="{Binding Estado, Converter={StaticResource FondoEstado}}"
                                                    StrokeThickness="0"
                                                    Padding="10,4"
                                                    WidthRequest="86"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding EstadoTexto}"
                                                       FontFamily="{StaticResource FuenteTexto}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{Binding Estado, Converter={StaticResource ColorEstado}}" />
                                            </Border>
                                        </Grid>
                                        <BoxView Color="{StaticResource Linea}" HeightRequest="1" VerticalOptions="End" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout Padding="22,26" Spacing="6" IsVisible="{Binding SinResultadosDirectorio}">
                            <Label Text="Sin expedientes"
                                   Style="{StaticResource TituloSeccion}"
                                   TextColor="{StaticResource AceroSuave}" />
                            <Label Style="{StaticResource CuerpoSuave}"
                                   Text="Esta empresa todavia no tiene colaboradores registrados." />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Alertas recientes -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" StrokeShape="RoundRectangle 6,6,6,6" VerticalOptions="Start">
                    <VerticalStackLayout>

                        <Grid Padding="22,18" ColumnDefinitions="22,*" ColumnSpacing="10">
                            <Path Grid.Column="0"
                                  Data="M10,2.2 C7.1,2.2 5.4,4.2 5.4,7.1 V11.6 L3.8,14.4 H16.2 L14.6,11.6 V7.1 C14.6,4.2 12.9,2.2 10,2.2 Z M8,16.4 C8.3,17.4 9.1,18 10,18 C10.9,18 11.7,17.4 12,16.4"
                                  Stroke="{StaticResource PincelSello}"
                                  StrokeThickness="1.6"
                                  WidthRequest="20" HeightRequest="20"
                                  VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Alertas recientes"
                                   Style="{StaticResource TituloSeccion}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Color="{StaticResource Linea}" HeightRequest="1" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Avisos}"
                                             Padding="16,16"
                                             Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="srv:LineaAviso">
                                    <Border BackgroundColor="{Binding Nivel, Converter={StaticResource FondoAviso}}"
                                            Stroke="{Binding Nivel, Converter={StaticResource PincelAviso}}"
                                            StrokeThickness="1"
                                            Padding="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="0">
                                            <BoxView Grid.Column="0"
                                                     Color="{Binding Nivel, Converter={StaticResource ColorAviso}}" />
                                            <Path Grid.Column="1"
                                                  Data="M10,2.5 A7.5,7.5 0 1,0 10,17.5 A7.5,7.5 0 1,0 10,2.5 Z M10,6 V11 M10,13.4 V13.8"
                                                  Stroke="{Binding Nivel, Converter={StaticResource PincelAviso}}"
                                                  StrokeThickness="1.6"
                                                  WidthRequest="20" HeightRequest="20"
                                                  Margin="12,14,0,0"
                                                  VerticalOptions="Start" />
                                            <VerticalStackLayout Grid.Column="2" Spacing="4" Padding="12,13,14,13">
                                                <Label Text="{Binding Titulo}"
                                                       FontFamily="{StaticResource FuenteTexto}"
                                                       FontSize="13.5"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding Nivel, Converter={StaticResource ColorAviso}}" />
                                                <Label Text="{Binding Descripcion}"
                                                       Style="{StaticResource CuerpoMenor}"
                                                       FontSize="12.5" />
                                                <Label Text="{Binding MomentoTexto}"
                                                       Style="{StaticResource DatoSuave}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout Padding="22,26" Spacing="6" IsVisible="{Binding SinAvisos}">
                            <Label Text="Nada pendiente"
                                   Style="{StaticResource TituloSeccion}"
                                   TextColor="{StaticResource AceroSuave}" />
                            <Label Style="{StaticResource CuerpoSuave}"
                                   Text="No hay vencimientos ni efemerides que atender en esta empresa." />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
